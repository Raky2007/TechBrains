# TechBrains Event Platform — Environment Configuration

# Server Network Configuration
# Bind to 0.0.0.0 so all computers on the college LAN can access the server
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Security & Admin Setup
# IMPORTANT: change ADMIN_PASSWORD before running a real event in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_before_event
SESSION_SECRET=change_this_to_a_long_random_secret

# Storage & Database
DATABASE_PATH=nexus.db
UPLOAD_DIR=server/uploads
MAX_UPLOAD_SIZE_MB=25

# Default Game Rules
LEVEL1_DURATION_MINUTES=10
LEVEL2_DURATION_MINUTES=20
INITIAL_CREDITS=200
ROUND2_MAX_SCORE=20
TIE_BREAKER_RULE=default

# AI Evaluation (Round 2 final answer)
# AI_PROVIDER: none | mock | anthropic | openai
#   none      -> no automatic evaluation; admins evaluate/override manually
#   mock      -> deterministic offline heuristic (good for LAN demos & tests)
#   anthropic -> uses the Claude Messages API (requires AI_API_KEY)
#   openai    -> uses the OpenAI Chat Completions API (requires AI_API_KEY)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# AI_BASE_URL=            # optional: override provider base URL / proxy
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
